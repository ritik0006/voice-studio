# Copy this file to ".env" (the .env file is ignored by git).

# XTTS-v2 asks you to accept the Coqui license (non-commercial use only).
# Read it at https://coqui.ai/cpml, then change 0 to 1 to accept.
COQUI_TOS_AGREED=0

# Whisper size: tiny, base, small, medium (bigger = more accurate and slower)
WHISPER_MODEL=small

# 1 = load both models when the server starts, 0 = load on first use
PRELOAD=1

MAX_TEXT_CHARS=1000
